<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MidiKeys.Controls"
             x:Class="MidiKeys.MainPage"
             Title="Piano"
             BackgroundColor="#1E1E1E">

    <Grid RowDefinitions="Auto,*" Padding="8" RowSpacing="8">

        <!-- Toolbar -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">

            <Button Text="▼" Clicked="OnOctaveDown" ToolTipProperties.Text="Octaaf omlaag"
                    FontSize="18" MinimumWidthRequest="44"
                    BackgroundColor="#333333" TextColor="#F2EFE6" />

            <Label x:Name="OctaveLabel" Grid.Column="1"
                   TextColor="#F2EFE6" FontAttributes="Bold" FontSize="16"
                   VerticalOptions="Center" HorizontalTextAlignment="Center"
                   MinimumWidthRequest="80" />

            <Button Grid.Column="2" Text="▲" Clicked="OnOctaveUp" ToolTipProperties.Text="Octaaf omhoog"
                    FontSize="18" MinimumWidthRequest="44"
                    BackgroundColor="#333333" TextColor="#F2EFE6" />

            <!-- The MIDI device is chosen in the side menu. -->
            <Picker x:Name="ChannelPicker" Grid.Column="4"
                    Title="Kanaal" WidthRequest="64"
                    TextColor="#F2EFE6" TitleColor="#BDB8AC"
                    SelectedIndexChanged="OnChannelSelected" />

            <Button x:Name="VelocityButton" Grid.Column="5" Text="⚙" Clicked="OnVelocitySettings" ToolTipProperties.Text="Aanslaggevoeligheid"
                    FontSize="18" MinimumWidthRequest="44"
                    BackgroundColor="#333333" TextColor="#F2EFE6" />
        </Grid>

        <!-- Keyboard: 2 octaves + top C -->
        <controls:PianoKeyboard x:Name="Keyboard" Grid.Row="1" WhiteKeyCount="15" />
    </Grid>
</ContentPage>
